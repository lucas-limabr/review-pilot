              "value": "Controlled failure while querying GitHub MCP get_file_contents. Verify file path, commit SHA/ref, or read-only token permissions.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000002-0000-4000-8000-000000000006",
      "name": "Format Controlled MCP Error",
