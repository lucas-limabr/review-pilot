          "conditions": [
            {
              "id": "cond-project-key",
              "leftValue": "={{ ($json.projectKey || '').trim() }}",
              "rightValue": "^[A-Za-z0-9_.:-]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d7000002-0000-4000-8000-000000000003",
      "name": "Validate Sonar Project Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        340
      ]
    },
    {
      "parameters": {
        "serverTransport": "httpStreamable",
        "endpointUrl": "http://sonarqube-mcp:8080/mcp",
        "authentication": "bearerAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "get_project_quality_gate_status"
        },
        "inputMode": "json",
        "jsonInput": "={\n  \"projectKey\": {{ JSON.stringify($json.projectKey) }}\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "d7000002-0000-4000-8000-000000000004",
      "name": "SonarQube MCP - get_project_quality_gate_status",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        740,
        240
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpBearerAuth": {
          "id": "CREDENTIAL_ID_SONARQUBE_MCP_BEARER",
          "name": "ReviewPilot SonarQube MCP Read-Only"
        }
      },
      "notesInFlow": true,
      "notes": "Queries SonarQube Quality Gate status via Streamable HTTP."
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "out-status",
