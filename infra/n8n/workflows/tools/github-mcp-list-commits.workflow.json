{
  "name": "ReviewPilot Tool - GitHub List Commits",
  "nodes": [
    {
      "parameters": {
        "content": "## ReviewPilot Tool - GitHub List Commits (Fase 6)\n- **Finalidade:** subworkflow somente leitura exposto ao `AI Agent` via `Call n8n Workflow Tool` (`github_list_commits_tool`).\n- **Servidor MCP:** `https://api.githubcopilot.com/mcp/` via `HTTP Streamable` (`httpStreamable`).\n- **Ferramenta MCP:** `list_commits` (lista histórico recente de commits de uma branch ou SHA).\n- **Segurança:** exige credencial `ReviewPilot GitHub MCP Read-Only` (`Multiple Headers Auth` com `Authorization: Bearer <PAT>`, `X-MCP-Readonly: true` e `X-MCP-Toolsets: repos,pull_requests`).",
        "height": 220,
        "width": 660
      },
      "id": "c6000003-0000-4000-8000-000000000001",
      "name": "Tool Architecture Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        40
      ]
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "owner",
              "type": "string"
            },
            {
              "name": "repo",
              "type": "string"
            },
            {
              "name": "sha",
              "type": "string"
            },
            {
              "name": "perPage",
              "type": "number"
            }
          ]
        }
      },
      "id": "c6000003-0000-4000-8000-000000000002",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-owner",
              "leftValue": "={{ $json.owner }}",
              "rightValue": "^[A-Za-z0-9_.-]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-repo",
              "leftValue": "={{ $json.repo }}",
              "rightValue": "^[A-Za-z0-9_.-]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-sha",
              "leftValue": "={{ $json.sha }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c6000003-0000-4000-8000-000000000003",
      "name": "Validate Commit List Inputs",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        340
      ],
      "notesInFlow": true,
      "notes": "Validates owner, repo, and branch/SHA reference."
    },
    {
      "parameters": {
        "serverTransport": "httpStreamable",
        "endpointUrl": "https://api.githubcopilot.com/mcp/",
        "authentication": "multipleHeadersAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "list_commits"
        },
        "inputMode": "json",
        "jsonInput": "={\n  \"owner\": {{ JSON.stringify($json.owner) }},\n  \"repo\": {{ JSON.stringify($json.repo) }},\n  \"sha\": {{ JSON.stringify($json.sha) }},\n  \"perPage\": {{ Math.min(Math.max(Number($json.perPage || 20), 1), 50) }}\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c6000003-0000-4000-8000-000000000004",
      "name": "GitHub MCP - list_commits",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        740,
        240
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpMultipleHeadersAuth": {
          "id": "CREDENTIAL_ID_GITHUB_MCP_HEADERS",
          "name": "ReviewPilot GitHub MCP Read-Only"
        }
      },
      "notesInFlow": true,
      "notes": "Calls remote GitHub MCP Server list_commits via Streamable HTTP."
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "out-status",
              "name": "status",
              "value": "SUCCESS",
              "type": "string"
            },
            {
              "id": "out-server",
              "name": "mcpServer",
              "value": "github-mcp",
              "type": "string"
            },
            {
              "id": "out-tool",
              "name": "toolName",
              "value": "list_commits",
              "type": "string"
            },
            {
              "id": "out-sha",
              "name": "sha",
              "value": "={{ $('When Executed by Another Workflow').item.json.sha }}",
              "type": "string"
            },
            {
              "id": "out-data",
              "name": "result",
              "value": "={{ $json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000003-0000-4000-8000-000000000005",
      "name": "Format MCP Tool Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1020,
        180
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "err-status",
              "name": "status",
              "value": "ERROR",
              "type": "string"
            },
            {
              "id": "err-server",
              "name": "mcpServer",
              "value": "github-mcp",
              "type": "string"
            },
            {
              "id": "err-tool",
              "name": "toolName",
              "value": "list_commits",
              "type": "string"
            },
            {
              "id": "err-msg",
              "name": "errorMessage",
              "value": "Controlled failure while querying GitHub MCP list_commits. Verify repository name, branch/SHA, or read-only token permissions.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000003-0000-4000-8000-000000000006",
      "name": "Format Controlled MCP Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1020,
        420
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Validate Commit List Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Commit List Inputs": {
      "main": [
        [
          {
            "node": "GitHub MCP - list_commits",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Controlled MCP Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub MCP - list_commits": {
      "main": [
        [
          {
            "node": "Format MCP Tool Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Controlled MCP Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "executionTimeout": 45
  },
  "versionId": "00000000-0000-4000-8000-000000000603",
