{
  "name": "ReviewPilot Tool - GitHub PR Read",
  "nodes": [
    {
      "parameters": {
        "content": "## ReviewPilot Tool - GitHub PR Read (Fase 6)\n- **Finalidade:** subworkflow somente leitura exposto ao `AI Agent` via `Call n8n Workflow Tool` (`github_pr_read_tool`).\n- **Servidor MCP:** `https://api.githubcopilot.com/mcp/` via `HTTP Streamable` (`httpStreamable`).\n- **Ferramenta MCP:** `pull_request_read` (restrita aos métodos de leitura `get`, `get_files`, `get_diff` e `get_commits`).\n- **Segurança:** exige credencial `ReviewPilot GitHub MCP Read-Only` (`Multiple Headers Auth` com `Authorization: Bearer <PAT>`, `X-MCP-Readonly: true` e `X-MCP-Toolsets: repos,pull_requests`). Nenhuma operação de escrita é permitida.",
        "height": 220,
        "width": 660
      },
      "id": "c6000001-0000-4000-8000-000000000001",
      "name": "Tool Architecture Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        40
      ]
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "owner",
              "type": "string"
            },
            {
              "name": "repo",
              "type": "string"
            },
            {
              "name": "pullNumber",
              "type": "number"
            },
            {
              "name": "method",
              "type": "string"
            }
          ]
        }
      },
      "id": "c6000001-0000-4000-8000-000000000002",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-owner",
              "leftValue": "={{ $json.owner }}",
              "rightValue": "^[A-Za-z0-9_.-]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-repo",
              "leftValue": "={{ $json.repo }}",
              "rightValue": "^[A-Za-z0-9_.-]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-pr-number",
              "leftValue": "={{ Number($json.pullNumber) }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "cond-method",
              "leftValue": "={{ $json.method }}",
              "rightValue": "^(get|get_files|get_diff|get_commits)$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c6000001-0000-4000-8000-000000000003",
      "name": "Validate Read-Only PR Inputs",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        340
      ],
      "notesInFlow": true,
      "notes": "Enforces read-only method allowlist (get, get_files, get_diff, get_commits)."
    },
    {
      "parameters": {
        "serverTransport": "httpStreamable",
        "endpointUrl": "https://api.githubcopilot.com/mcp/",
        "authentication": "multipleHeadersAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "pull_request_read"
        },
        "inputMode": "json",
        "jsonInput": "={\n  \"owner\": {{ JSON.stringify($json.owner) }},\n  \"repo\": {{ JSON.stringify($json.repo) }},\n  \"pullNumber\": {{ Number($json.pullNumber) }},\n  \"method\": {{ JSON.stringify($json.method) }}\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c6000001-0000-4000-8000-000000000004",
      "name": "GitHub MCP - pull_request_read",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        740,
        240
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpMultipleHeadersAuth": {
          "id": "CREDENTIAL_ID_GITHUB_MCP_HEADERS",
          "name": "ReviewPilot GitHub MCP Read-Only"
        }
      },
      "notesInFlow": true,
      "notes": "Calls remote GitHub MCP Server via Streamable HTTP in read-only mode."
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "out-status",
              "name": "status",
              "value": "SUCCESS",
              "type": "string"
            },
            {
              "id": "out-server",
              "name": "mcpServer",
              "value": "github-mcp",
              "type": "string"
            },
            {
              "id": "out-tool",
              "name": "toolName",
              "value": "pull_request_read",
              "type": "string"
            },
            {
              "id": "out-method",
              "name": "method",
              "value": "={{ $('When Executed by Another Workflow').item.json.method }}",
              "type": "string"
            },
            {
              "id": "out-data",
              "name": "result",
              "value": "={{ $json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000001-0000-4000-8000-000000000005",
      "name": "Format MCP Tool Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1020,
        180
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "err-status",
              "name": "status",
              "value": "ERROR",
              "type": "string"
            },
            {
              "id": "err-server",
              "name": "mcpServer",
              "value": "github-mcp",
              "type": "string"
            },
            {
              "id": "err-tool",
              "name": "toolName",
              "value": "pull_request_read",
              "type": "string"
            },
            {
              "id": "err-msg",
              "name": "errorMessage",
              "value": "Controlled failure while querying GitHub MCP pull_request_read. Check repository access, PR number, or read-only token permissions.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000001-0000-4000-8000-000000000006",
      "name": "Format Controlled MCP Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1020,
        420
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
