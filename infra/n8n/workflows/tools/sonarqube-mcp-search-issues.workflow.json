            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Optional SonarQube Unavailable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SonarQube MCP - search_sonar_issues_in_projects": {
      "main": [
        [
          {
            "node": "Format SonarQube Tool Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Optional SonarQube Unavailable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
