# Application
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=UTC

# ReviewPilot database
POSTGRES_DB=reviewpilot
POSTGRES_USER=reviewpilot
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
INTERNAL_SERVICE_TOKEN=CHANGE_ME_LOCALLY
GITHUB_WEBHOOK_SECRET=CHANGE_ME_LOCALLY
N8N_INTERNAL_WEBHOOK_URL=http://n8n:5678/webhook/reviewpilot-dispatch

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME_LOCALLY
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# SonarQube Community Build (optional profile: quality)
SONARQUBE_URL=http://sonarqube:9000
SONARQUBE_PORT=9000

# SonarQube MCP Server (optional profile: quality)
SONARQUBE_TRANSPORT=http
SONARQUBE_HTTP_HOST=0.0.0.0
SONARQUBE_HTTP_PORT=8080
SONARQUBE_MCP_IN_CONTAINER=true
SONARQUBE_READ_ONLY=true

# Frontend (optional profile: frontend)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

